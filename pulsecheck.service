[Unit]
Description=PulseCheck Telegram uptime bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/pulsecheck
ExecStart=/opt/pulsecheck/pulsecheck
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=pulsecheck
Environment=DB_PATH=/var/lib/pulsecheck/pulsecheck.db
EnvironmentFile=/opt/pulsecheck/.env
NoNewPrivileges=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
