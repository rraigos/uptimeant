# Copy this file to .env (or put the same values into your service's environment file).

# Bot token from @BotFather (command /newbot).
BOT_TOKEN=123456789:replace_me

# Payment support contact (@nickname or e-mail) shown by /paysupport. Telegram requires a working
# contact for bots that take payments, so /premium and Star payments stay disabled while this is empty.
SUPPORT_USERNAME=

# Public HTTPS base URL of the service, without a trailing slash. A path prefix is allowed when a
# reverse proxy strips it (https://host/uptimeant). This address ends up in the Telegram webhook,
# in heartbeat ping URLs and in the agent install command.
WEBHOOK_URL=https://your-domain.example

# Where to listen. Behind Nginx keep it on localhost. LISTEN_ADDR is either "host:port" or just
# "host", in which case the port is taken from PORT.
LISTEN_ADDR=127.0.0.1:3000
PORT=3000

# Numeric Telegram IDs of the administrators, comma-separated (your own ID is shown by @getidsbot).
# They alone can issue Star refunds through /payments and /refund.
ADMIN_IDS=

# Optional:
# TIMEZONE=Europe/Berlin   # IANA zone dates are rendered in, UTC when unset
# DB_PATH=uptimeant.db
# TELEGRAM_API_URL=http://127.0.0.1:8081   # local Bot API server or a test stub
